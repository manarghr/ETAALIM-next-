
# Copy to .env.local for development, and paste the same keys into your host's
# environment variables for production. .env.local is gitignored — never commit
# real values.

# Supabase → Project Settings → API
# Just the project origin, with no /rest/v1 path on the end.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The "anon public" key. It is meant to be public (it ships in the browser
# bundle); the database is protected by Row Level Security, not by hiding it.
# Never put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The site's public address, used for sitemap.xml, robots.txt and link previews.
# Leave unset locally; set it to the real domain in production.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
